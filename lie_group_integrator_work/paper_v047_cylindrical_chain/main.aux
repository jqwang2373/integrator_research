\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces State-dependent velocity-compression probe. Diagonal state-local direction oracles with meaningful non-final-stage energy still fail to span the local terminal-bridge target.}}{15}{figure.9}\protected@file@percent }
\newlabel{fig:velocity-compression-state-dependent}{{9}{15}{State-dependent velocity-compression probe. Diagonal state-local direction oracles with meaningful non-final-stage energy still fail to span the local terminal-bridge target}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Non-final component-mixing probe. Removing the final-stage rows and allowing full stage-0/stage-1 component mixing still does not span the terminal bridge.}}{16}{figure.10}\protected@file@percent }
