\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Value-level source-free compression probe. Value fits can balance rows, but meaningful non-final value-level fits do not span the terminal bridge.}}{16}{figure.11}\protected@file@percent }
\newlabel{fig:velocity-compression-value-level}{{11}{16}{Value-level source-free compression probe. Value fits can balance rows, but meaningful non-final value-level fits do not span the terminal bridge}{figure.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Derivative-aware value-level oracle. A coefficient-gradient correction gives meaningful non-final value-balanced tangent spans, but it is still a local oracle rather than a bounded nonlinear row formula.}}{17}{figure.12}\protected@file@percent }
\newlabel{fig:velocity-compression-derivative-aware}{{12}{17}{Derivative-aware value-level oracle. A coefficient-gradient correction gives meaningful non-final value-balanced tangent spans, but it is still a local oracle rather than a bounded nonlinear row formula}{figure.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Bounded-gradient cap sweep. The local derivative-aware oracle is capped by a global Frobenius gradient budget. Practical caps recover only part of the local tangent span, while all local spans require cap $10^{18}$.}}{17}{figure.13}\protected@file@percent }
\newlabel{fig:velocity-compression-bounded-gradient}{{13}{17}{Bounded-gradient cap sweep. The local derivative-aware oracle is capped by a global Frobenius gradient budget. Practical caps recover only part of the local tangent span, while all local spans require cap $10^{18}$}{figure.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Bounded analytic saturation-law probe. Tanh and rational saturation laws preserve the value balance, but all local spans require cap $10^{22}$ and the correction direction is still a target-direction oracle.}}{18}{figure.14}\protected@file@percent }
\newlabel{fig:velocity-compression-bounded-formula}{{14}{18}{Bounded analytic saturation-law probe. Tanh and rational saturation laws preserve the value balance, but all local spans require cap $10^{22}$ and the correction direction is still a target-direction oracle}{figure.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Target-direction-free bounded formula probe. The correction direction is computed from the current closure and active non-final velocity rows, not from the target Jacobian.}}{18}{figure.15}\protected@file@percent }
\newlabel{fig:velocity-compression-target-free-formula}{{15}{18}{Target-direction-free bounded formula probe. The correction direction is computed from the current closure and active non-final velocity rows, not from the target Jacobian}{figure.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Direction-capacity audit. All-stage velocity feature spaces can reproduce the local derivative-aware correction, but non-final active/source feature spaces cannot.}}{19}{figure.16}\protected@file@percent }
\newlabel{fig:velocity-compression-direction-capacity}{{16}{19}{Direction-capacity audit. All-stage velocity feature spaces can reproduce the local derivative-aware correction, but non-final active/source feature spaces cannot}{figure.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Nonlinear second-differential capacity audit. Finite-difference source features increase the local non-final feature library, but none spans the local lower-pair correction.}}{19}{figure.17}\protected@file@percent }
\newlabel{fig:velocity-compression-nonlinear-capacity}{{17}{19}{Nonlinear second-differential capacity audit. Finite-difference source features increase the local non-final feature library, but none spans the local lower-pair correction}{figure.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Higher-order/nonlocal capacity audit. Third finite-difference source features and same-case cross-step source deltas still do not span the local lower-pair correction.}}{20}{figure.18}\protected@file@percent }
\newlabel{fig:velocity-compression-higher-order-capacity}{{18}{20}{Higher-order/nonlocal capacity audit. Third finite-difference source features and same-case cross-step source deltas still do not span the local lower-pair correction}{figure.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces History-transport capacity audit. One-step transported source-row and non-final velocity-row deltas still do not span the local lower-pair correction.}}{20}{figure.19}\protected@file@percent }
\newlabel{fig:velocity-compression-history-capacity}{{19}{20}{History-transport capacity audit. One-step transported source-row and non-final velocity-row deltas still do not span the local lower-pair correction}{figure.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces Two-step history-transport capacity audit. Transported source-row and non-final velocity-row deltas from two future states still do not span the local lower-pair correction.}}{21}{figure.20}\protected@file@percent }
\newlabel{fig:velocity-compression-multi-step-history-capacity}{{20}{21}{Two-step history-transport capacity audit. Transported source-row and non-final velocity-row deltas from two future states still do not span the local lower-pair correction}{figure.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces Recurrent history-capacity audit. Two-step curvature and bilinear source/velocity history features still do not span the local lower-pair correction.}}{21}{figure.21}\protected@file@percent }
\newlabel{fig:velocity-compression-recurrent-history-capacity}{{21}{21}{Recurrent history-capacity audit. Two-step curvature and bilinear source/velocity history features still do not span the local lower-pair correction}{figure.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces Weak-row structure-capacity audit. Source/active cross-Gram, Hadamard, cross-Hadamard, and shifted-commutator feature rows still do not span the local lower-pair correction.}}{22}{figure.22}\protected@file@percent }
\newlabel{fig:velocity-compression-weak-row-structure-capacity}{{22}{22}{Weak-row structure-capacity audit. Source/active cross-Gram, Hadamard, cross-Hadamard, and shifted-commutator feature rows still do not span the local lower-pair correction}{figure.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {23}{\ignorespaces Row-space compression audit. Target-free SVD, row-norm, and stage-balanced frozen eight-row compressions of the all-stage/non-final velocity row space do not provide a value-balanced tangent closure.}}{22}{figure.23}\protected@file@percent }
